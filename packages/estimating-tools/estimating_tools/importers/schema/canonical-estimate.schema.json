{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estimating-tools.local/canonical-estimate.schema.json",
  "title": "Canonical estimate",
  "type": "object",
  "required": ["project", "schedules"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bid_date": { "type": "string" },
        "owner": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "items"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item_number"],
              "properties": {
                "item_number": { "type": "string", "minLength": 1 },
                "item_code": { "type": ["string", "null"] },
                "description": { "type": "string" },
                "quantity": { "type": ["number", "null"] },
                "unit": { "type": "string" },
                "unit_price": { "type": ["number", "null"] },
                "total": { "type": ["number", "null"] },
                "breakdown": { "type": ["object", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
